spring.profiles.active=local
AUTH0_ISSUER_URI=https://your-tenant.us.auth0.com/
AUTH0_EMAIL_CLAIM=https://subscript.app/email
AUTH0_EMAIL_VERIFIED_CLAIM=https://subscript.app/email_verified
FRONTEND_ORIGIN=http://localhost:5173
# For Neon, set spring.profiles.active=neon and use the pooled application URL plus direct migration URL.
# Copy both connection strings from Neon Connection Details; use a -pooler hostname for the app URL.
NEON_JDBC_URL=jdbc:postgresql://ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
NEON_MIGRATION_JDBC_URL=jdbc:postgresql://ep-example.region.aws.neon.tech/neondb?sslmode=require
NEON_DB_USERNAME=neondb_owner
NEON_DB_PASSWORD=replace-me
NEON_POOL_MAX_SIZE=8
